# Copy to .env for local development. Never commit the real .env.
# ENV selects the database (emporos vs emporos_dev) — see plan.md §6.0.
# Unset or anything other than "main" resolves to emporos_dev. Only ENV=main is production.
ENV=local

# Atlas connection string, shared across all non-production environments.
MONGO_URL=

# Optional: pin the database name (e.g. emporos_smoke for an isolated smoke test) instead of
# the ENV-derived default. Ignored under ENV=main — production always uses "emporos".
MONGO_DB_NAME=

# Angel One SmartAPI credentials (obtained via SmartAPI onboarding, EM-42).
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
ANGELONE_API_KEY=

LOG_LEVEL=INFO

# Optional: override the upstream instrument-master URL (defaults to Angel One's).
INSTRUMENT_MASTER_URL=

# Cold storage (candle Parquet archive). Leave S3_ENDPOINT_URL empty for real AWS S3;
# point it at a local MinIO (docker/compose.yml) for development — no AWS credentials needed.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Or, with no bucket, a local directory as the cold tier (bars older than their hot retention):
COLD_ARCHIVE_DIR=
AWS_REGION=ap-south-1

# Where a backtest keeps its local copy of closed candle months. Derived data: unset uses
# ~/.cache/emporos/candles, and deleting it only makes the next backtest slower.
CANDLE_CACHE_DIR=

# Optional: the X-Client* headers SmartAPI wants. Placeholders are fine for login, quotes and
# history; only order APIs check them against the registered static IP (plan.md §1.3).
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_MAC_ADDRESS=

# Real orders are inert unless this is EXACTLY "true" — a typo, "1" or "yes" leaves live trading
# disabled (TradingModeGuard, plan.md §11). Paper trading is never affected by this flag.
LIVE_TRADING_ENABLED=
# The kill switch's file sentinel: while this file exists, all new orders are halted. Unset uses
# ~/.emporos/HALT. Reachable independent of the dashboard, by design (plan.md's kill-switch
# independence invariant).
KILL_SWITCH_FILE=

# The control-plane API (dashboard backend). The signing secret comes from here locally and from
# SSM Parameter Store in production — never written to Git either way.
API_JWT_SECRET=
# Comma-separated allowed origins for the dashboard's CORS policy.
API_CORS_ORIGINS=
# The account whose books the API shows: the paper account id, or the live client code.
API_ACCOUNT_ID=

# Jev (EM-152/EM-160): optional AI decision-provider, reached through the Vercel Gateway.
# Setting this key does NOT turn Jev on by itself — it stays disabled until enabled in
# config/settings.*.yaml. Production uses secure deployment environment configuration instead
# of a checked-in .env.
VERCEL_GATEWAY_KEY=
