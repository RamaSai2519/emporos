[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[requires]
python_version = "3.12"

[packages]
emporos = {path = ".", editable = true}
httpx = "==0.27.2"
pydantic = "==2.9.2"
pydantic-settings = "==2.5.2"
pymongo = "==4.9.1"
pyotp = "==2.9.0"
typer = "==0.12.5"
pyyaml = "==6.0.2"
python-ulid = "==2.7.0"
structlog = "==24.4.0"
tenacity = "==9.0.0"
websockets = "==13.1"
fastapi = "==0.115.0"
uvicorn = {extras = ["standard"], version = "==0.30.6"}
boto3 = "==1.35.36"

[dev-packages]
pytest = "==8.3.3"
pytest-asyncio = "==0.24.0"
pytest-cov = "==5.0.0"
freezegun = "==1.5.1"
hypothesis = "==6.112.2"
respx = "==0.21.1"
mypy = "==1.11.2"
ruff = "==0.6.9"
import-linter = "==2.1"
bandit = "==1.7.10"
pip-audit = "==2.7.3"
types-pyyaml = "==6.0.12.20240917"
boto3-stubs = {extras = ["s3"], version = "==1.35.36"}

[scripts]
lint = "ruff check src tests"
fmt = "ruff format src tests"
typecheck = "mypy --strict src/emporos/domain src/emporos/broker src/emporos/risk src/emporos/execution"
test = "pytest"
emporos = "python -m emporos.cli"
